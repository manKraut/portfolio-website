---
import Section from './Section.astro';
import { profile, education } from '../data/profile';
---

<Section id="about" title="About">
  <div class="grid gap-10 md:grid-cols-3">
    <div class="space-y-4 text-base leading-relaxed md:col-span-2">
      {profile.summary.map((p) => <p>{p}</p>)}
    </div>

    <div>
      <h3 class="mb-3 text-sm font-semibold text-slate-900 dark:text-white">Education</h3>
      <ul class="space-y-4 text-sm">
        {
          education.map((e) => (
            <li>
              <p class="font-medium text-slate-900 dark:text-slate-100">{e.degree}</p>
              <p class="text-slate-500 dark:text-slate-400">
                {e.school} · {e.grade}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>
