---
import Section from './Section.astro';
import { profile } from '../data/profile';

const links = [
  { label: 'Email', href: `mailto:${profile.email}`, text: profile.email },
  { label: 'GitHub', href: profile.github, text: profile.github.replace('https://', '') },
  ...(profile.linkedin
    ? [{ label: 'LinkedIn', href: profile.linkedin, text: profile.linkedin.replace('https://', '') }]
    : []),
];
---

<Section id="contact" title="Contact">
  <div class="rounded-3xl border border-line bg-surface p-8 shadow-sm sm:p-12">
    <p class="font-serif text-3xl font-semibold text-ink sm:text-4xl">Let’s build something.</p>
    <p class="mt-4 max-w-xl text-lg leading-relaxed text-muted">
      I’m always happy to talk about AI systems, data engineering, or interesting problems. The
      inbox is open.
    </p>

    <a
      href={`mailto:${profile.email}`}
      class="mt-7 inline-block rounded-lg bg-accent px-6 py-3 text-base font-semibold text-on-accent shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
    >
      Say hello
    </a>

    <ul class="mt-9 space-y-3">
      {
        links.map((l) => (
          <li>
            <span class="inline-block w-24 font-semibold text-sage">{l.label}</span>
            <a
              href={l.href}
              class="text-muted underline decoration-line underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
              target={l.href.startsWith('http') ? '_blank' : undefined}
              rel="noopener"
            >
              {l.text}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Section>
