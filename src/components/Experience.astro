---
import Section from './Section.astro';
import { experience } from '../data/profile';
---

<Section id="experience" title="Experience">
  <ol class="space-y-10 border-l border-slate-200 pl-6 dark:border-slate-800">
    {
      experience.map((job) => (
        <li class="relative">
          <span class="absolute -left-[1.85rem] top-2 size-2.5 rounded-full bg-accent ring-4 ring-slate-50 dark:ring-slate-950" />
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white">
              {job.title} <span class="text-accent dark:text-accent-soft">@ {job.company}</span>
            </h3>
            <span class="font-mono text-xs text-slate-500 dark:text-slate-400">{job.period}</span>
          </div>
          {job.blurb && <p class="mt-1 text-sm italic text-slate-500 dark:text-slate-400">{job.blurb}</p>}
          <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed marker:text-slate-400">
            {job.highlights.map((h) => <li>{h}</li>)}
          </ul>
        </li>
      ))
    }
  </ol>
</Section>
