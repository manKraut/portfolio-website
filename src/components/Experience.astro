---
import Section from './Section.astro';
import { experience } from '../data/profile';
---

<Section id="experience" title="Experience">
  <ol class="space-y-8 border-l-2 border-line pl-8">
    {
      experience.map((job) => (
        <li class="relative rounded-2xl border border-line bg-surface p-6 shadow-sm">
          <span class="absolute -left-[2.8rem] top-7 size-4 rounded-full bg-accent ring-4 ring-paper" />
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="text-xl font-semibold text-ink">
              {job.title} <span class="text-accent">@ {job.company}</span>
            </h3>
            <span class="rounded-full bg-sunken px-3 py-1 font-mono text-xs text-muted">{job.period}</span>
          </div>
          {job.blurb && <p class="mt-2 italic text-sage">{job.blurb}</p>}
          <ul class="mt-4 list-disc space-y-2 pl-5 leading-relaxed text-muted marker:text-gold">
            {job.highlights.map((h) => <li>{h}</li>)}
          </ul>
        </li>
      ))
    }
  </ol>
</Section>
