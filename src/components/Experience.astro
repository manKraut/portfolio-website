---
import Section from './Section.astro';
import { experience } from '../data/profile';
---

<Section id="experience" title="Experience">
  <ol class="space-y-6 border-l-2 border-line pl-8">
    {
      experience.map((job) => (
        <li class="relative">
          <span class="absolute -left-[2.8rem] top-8 size-4 rounded-full bg-accent ring-4 ring-paper" />
          <details
            class="group rounded-2xl border border-line bg-surface shadow-sm transition-shadow open:shadow-md hover:border-accent/60"
          >
            <summary class="flex cursor-pointer list-none items-start gap-4 p-6 [&::-webkit-details-marker]:hidden">
              <div class="flex-1">
                <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
                  <h3 class="text-xl font-semibold text-ink">
                    {job.title} <span class="text-accent">@ {job.company}</span>
                  </h3>
                  <span class="w-fit shrink-0 rounded-full bg-sunken px-3 py-1 font-mono text-xs text-muted">
                    {job.period}
                  </span>
                </div>
                {job.blurb && <p class="mt-2 text-sm italic text-sage">{job.blurb}</p>}
                <p class="mt-3 leading-relaxed text-muted">{job.brief}</p>
                <p class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-sage">
                  <span class="group-open:hidden">Show details</span>
                  <span class="hidden group-open:inline">Hide details</span>
                  <svg class="size-4 transition-transform duration-300 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </p>
              </div>
            </summary>

            <div class="space-y-6 border-t border-line px-6 pb-6 pt-5">
              {job.sections.map((sec) => (
                <div>
                  {sec.heading && <h4 class="mb-3 font-serif text-lg font-semibold text-gold">{sec.heading}</h4>}
                  <ul class="list-disc space-y-3 pl-5 leading-relaxed text-muted marker:text-gold">
                    {sec.highlights.map((h) => <li>{h}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          </details>
        </li>
      ))
    }
  </ol>
</Section>
