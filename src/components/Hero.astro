---
import { profile } from '../data/profile';
---

<section id="top" class="mx-auto max-w-5xl px-6 pb-8 pt-20 sm:pt-28">
  <p class="mb-4 font-mono text-sm text-accent dark:text-accent-soft">Hi, my name is</p>
  <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-6xl dark:text-white">
    {profile.name}.
  </h1>
  <p class="mt-3 text-2xl font-semibold text-slate-500 sm:text-4xl dark:text-slate-400">
    {profile.role} · {profile.tagline}
  </p>
  <p class="mt-6 max-w-2xl text-lg leading-relaxed">{profile.intro}</p>

  <div class="mt-8 flex flex-wrap gap-3">
    <a
      href="#projects"
      class="rounded-lg bg-accent px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-indigo-500"
    >
      See my projects
    </a>
    <a
      href={profile.cv}
      target="_blank"
      rel="noopener"
      class="rounded-lg border border-slate-300 px-5 py-2.5 text-sm font-medium text-slate-700 transition-colors hover:border-accent hover:text-accent dark:border-slate-700 dark:text-slate-300 dark:hover:border-accent-soft dark:hover:text-accent-soft"
    >
      Download CV
    </a>
  </div>
</section>
