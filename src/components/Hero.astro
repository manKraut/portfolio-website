---
import { profile } from '../data/profile';
---

<section id="top" class="mx-auto max-w-5xl px-6 pb-10 pt-16 sm:pt-24">
  <div class="flex flex-col-reverse items-start gap-10 md:flex-row md:items-center md:justify-between">
    <div class="max-w-2xl">
      <p
        class="mb-5 inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 font-mono text-xs text-sage"
      >
        <span class="size-2 rounded-full bg-sage"></span>
        {profile.tagline}
      </p>
      <h1 class="text-5xl font-semibold leading-[1.05] tracking-tight text-ink sm:text-7xl">
        {profile.name}
      </h1>
      <p class="mt-4 font-serif text-2xl italic text-accent sm:text-3xl">{profile.role}</p>
      <p class="mt-6 text-xl leading-relaxed text-muted">{profile.intro}</p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href="#projects"
          class="rounded-lg bg-accent px-6 py-3 text-base font-semibold text-on-accent shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
        >
          See my projects
        </a>
        <a
          href={profile.cv}
          target="_blank"
          rel="noopener"
          class="rounded-lg border-2 border-sage px-6 py-3 text-base font-semibold text-sage transition hover:bg-sage hover:text-paper"
        >
          Download CV
        </a>
      </div>
    </div>

    {
      profile.photo && (
        <img
          src={profile.photo}
          alt={profile.name}
          width="260"
          height="260"
          class="size-44 shrink-0 rounded-full object-cover shadow-lg ring-4 ring-accent/60 ring-offset-4 ring-offset-paper sm:size-60"
        />
      )
    }
  </div>
</section>
