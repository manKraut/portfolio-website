---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const { title, description, tech, repo, link, image, gallery } = project.data;
const { Content } = await render(project);

// Where a click on the card goes: the live subdomain (`link`) if set, otherwise the GitHub repo.
const href = link ?? repo;

// Cards without a photo get a colourful gradient banner instead.
const gradients = [
  'from-accent/80 to-gold/70',
  'from-sage/80 to-accent/60',
  'from-gold/80 to-sage/70',
];
const gradient = gradients[index % gradients.length];

const buttonClass =
  'relative z-10 rounded-lg border border-line px-4 py-2 text-sm font-semibold text-ink transition-colors hover:border-accent hover:text-accent';
---

<article
  class="group relative flex flex-col overflow-hidden rounded-2xl border border-line bg-surface shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl"
>
  {
    image ? (
      <Image src={image} alt={`${title} screenshot`} class="aspect-video w-full object-cover" widths={[480, 800, 1200]} sizes="(min-width: 768px) 50vw, 100vw" />
    ) : (
      <div class={`flex aspect-video w-full items-center justify-center bg-gradient-to-br ${gradient}`}>
        <span class="font-serif text-7xl font-semibold text-on-accent/90">{title.charAt(0)}</span>
      </div>
    )
  }

  {
    gallery.length > 0 && (
      <div class="grid grid-cols-3 gap-1 border-b border-line bg-sunken p-1">
        {gallery.map((img) => (
          <Image src={img} alt={`${title} screenshot`} class="aspect-video w-full rounded object-cover" widths={[240, 480]} sizes="200px" />
        ))}
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-7">
    <h3 class="text-2xl font-semibold text-ink transition-colors group-hover:text-accent">
      {
        href ? (
          <a href={href} target="_blank" rel="noopener" class="after:absolute after:inset-0 after:content-['']">
            {title}
          </a>
        ) : (
          title
        )
      }
    </h3>
    <p class="mt-3 leading-relaxed text-muted">{description}</p>

    <div
      class="mt-4 leading-relaxed text-muted [&_code]:rounded [&_code]:bg-sunken [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-sm [&_code]:text-accent [&_li]:mt-2 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:marker:text-gold"
    >
      <Content />
    </div>

    <div class="mt-auto pt-6">
      {
        tech.length > 0 && (
          <ul class="flex flex-wrap gap-2">
            {tech.map((t, i) => (
              <li
                class={`rounded-full px-3 py-1 font-mono text-xs font-medium ${
                  ['bg-accent/10 text-accent', 'bg-sage/10 text-sage', 'bg-gold/10 text-gold'][i % 3]
                }`}
              >
                {t}
              </li>
            ))}
          </ul>
        )
      }
      {
        (repo || link) && (
          <div class="mt-5 flex gap-3">
            {repo && (
              <a href={repo} target="_blank" rel="noopener" class={buttonClass}>
                Code ↗
              </a>
            )}
            {link && (
              <a href={link} target="_blank" rel="noopener" class={buttonClass}>
                Live demo ↗
              </a>
            )}
          </div>
        )
      }
    </div>
  </div>
</article>
