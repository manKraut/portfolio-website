---
// Shared wrapper so every section has the same spacing and heading style.
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section id={id} class="reveal mx-auto max-w-5xl px-6 py-16 sm:py-20">
  <h2 class="mb-10 flex items-center gap-4 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
    <span class="h-8 w-1.5 rounded-full bg-gradient-to-b from-accent to-gold"></span>
    {title}
    <span class="h-px flex-1 bg-line"></span>
  </h2>
  <slot />
</section>
