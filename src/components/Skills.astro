---
import Section from './Section.astro';
import { skills } from '../data/profile';
---

<Section id="skills" title="Skills">
  <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {
      skills.map((s) => (
        <div>
          <h3 class="mb-3 text-sm font-semibold text-slate-900 dark:text-white">{s.group}</h3>
          <ul class="flex flex-wrap gap-2">
            {s.items.map((item) => (
              <li class="rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs dark:border-slate-800 dark:bg-slate-900">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
