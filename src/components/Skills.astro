---
import Section from './Section.astro';
import { skills } from '../data/profile';

// Each skill group gets its own accent colour, cycling through the palette.
const tones = [
  'border-accent/40 bg-accent/10 text-accent',
  'border-sage/40 bg-sage/10 text-sage',
  'border-gold/40 bg-gold/10 text-gold',
];
const titles = ['text-accent', 'text-sage', 'text-gold'];
---

<Section id="skills" title="Skills">
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      skills.map((s, i) => (
        <div class="rounded-2xl border border-line bg-surface p-6 shadow-sm">
          <h3 class={`mb-4 text-xl font-semibold ${titles[i % 3]}`}>{s.group}</h3>
          <ul class="flex flex-wrap gap-2">
            {s.items.map((item) => (
              <li class={`rounded-full border px-3 py-1 text-sm font-medium ${tones[i % 3]}`}>{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
